// Apsis — Site ve Apartman Yönetim Otomasyonu
// Veri modeli, apsis-proje-dokumani.md bölüm 4 baz alınarak hazırlanmıştır.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enum'lar
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_STAFF
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

enum UnitType {
  MESKEN
  ISYERI
  DEPO
  DIGER
}

/// Konut daireleri için oda tipolojisi (1+1, 2+1, 3+1…). Sadece UnitType=MESKEN olan
/// dairelerde anlamlıdır; işyeri/depo/diğer tiplerde null bırakılır.
enum RoomLayout {
  BIR_ARTI_BIR
  IKI_ARTI_BIR
  UC_ARTI_BIR
  DIGER
}

enum ResidentRelation {
  MALIK
  KIRACI
}

enum DuesPaymentMethod {
  NAKIT
  HAVALE
  EFT
  DIGER
}

enum MaintenancePeriod {
  AYLIK
  UC_AYLIK
  YILLIK
}

enum TicketPriority {
  DUSUK
  ORTA
  YUKSEK
  ACIL
}

enum TicketStatus {
  ACIK
  ISLEMDE
  COZULDU
  IPTAL
}

enum AnnouncementAudience {
  TUM_SITE
  BLOK
  SECILI_DAIRELER
}

enum InvoiceStatus {
  BEKLIYOR
  ODENDI
  GECIKTI
}

enum BankAccountType {
  KASA
  BANKA
}

enum TransactionDirection {
  GIRIS
  CIKIS
}

// ---------------------------------------------------------------------------
// Çekirdek modül: Şirket, Kullanıcı, Site, Blok, Daire, Sakin
// ---------------------------------------------------------------------------

model Company {
  id                 String             @id @default(cuid())
  name               String
  taxNumber          String?            @unique
  contactEmail       String?
  contactPhone       String?
  billingAddress     String?
  logoUrl            String?
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  packageId          String?
  package            SubscriptionPackage? @relation("CompanyPackage", fields: [packageId], references: [id], onDelete: SetNull)
  /// Sadece atanan paket isCustom=true ise anlamlıdır — superadmin tarafından elle belirlenir.
  customUnitLimit    Int?
  customMonthlyPrice Decimal?             @db.Decimal(12, 2)

  /// Bekleyen paket yükseltme talebi — ikisi de null ise bekleyen talep yoktur.
  requestedPackageId String?
  requestedPackage   SubscriptionPackage? @relation("CompanyRequestedPackage", fields: [requestedPackageId], references: [id], onDelete: SetNull)
  requestedAt        DateTime?

  users    User[]
  sites    Site[]
  vendors  Vendor[]
  invoices Invoice[]

  @@index([packageId])
  @@index([requestedPackageId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  siteAccess UserSiteAccess[]

  @@index([companyId])
}

model Site {
  id                 String   @id @default(cuid())
  name               String
  address            String?
  managementPlanNo   String?
  /// Aylık gecikme faizi oranı (%) — aidat vadesi geçtikçe otomatik faiz hesaplamasında kullanılır. Boşsa otomatik faiz uygulanmaz.
  lateFeeRatePercent Decimal? @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  blocks               Block[]
  units                Unit[]
  userAccess           UserSiteAccess[]
  expenses             Expense[]
  maintenanceSchedules MaintenanceSchedule[]
  tickets              Ticket[]
  staff                Staff[]
  meetings             Meeting[]
  decisions            Decision[]
  documents            Document[]
  announcements        Announcement[]
  vendors              Vendor[]
  budgetItems          BudgetItem[]
  bankAccounts         BankAccount[]
  duesRates            SiteDuesRate[]

  @@index([companyId])
}

/// Sitenin dönemsel aidat tarifesi — tutar değiştikçe yeni bir satır eklenir (geçmiş korunur).
/// Bir dönem için geçerli tarife: validFrom <= dönem VE (validTo IS NULL VEYA dönem < validTo).
/// Yeni bir tarife eklendiğinde, ondan önceki açık uçlu (validTo=null) tarifenin validTo'su
/// otomatik olarak yeni tarifenin validFrom'una çekilir (bkz. setSiteDuesRateAction).
model SiteDuesRate {
  id        String    @id @default(cuid())
  amount    Decimal   @db.Decimal(12, 2)
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Block {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  units         Unit[]
  announcements Announcement[]

  @@unique([siteId, name])
  @@index([siteId])
}

model Unit {
  id         String      @id @default(cuid())
  unitNumber String
  floor      String?
  areaM2     Decimal?    @db.Decimal(8, 2)
  type       UnitType    @default(MESKEN)
  /// Sadece type=MESKEN olduğunda anlamlıdır (1+1, 2+1…) — diğer tiplerde null.
  roomLayout RoomLayout?
  landShare  Decimal?    @db.Decimal(8, 4)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  siteId  String
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blockId String?
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  residents     Resident[]
  duesRecords   DuesRecord[]
  tickets       Ticket[]
  announcements Announcement[]

  @@index([siteId])
  @@index([blockId])
}

model Resident {
  id           String           @id @default(cuid())
  fullName     String
  nationalId   String?
  phone        String?
  email        String?
  relationType ResidentRelation
  moveInDate   DateTime?
  moveOutDate  DateTime?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

/// Şirket personelinin hangi sitelere erişebileceğini tutar (site bazlı yetki).
/// COMPANY_ADMIN rolü için satır gerekmez — şirketin tüm sitelerine örtük erişimi vardır.
model UserSiteAccess {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Sonraki iterasyonlarda UI/API eklenecek modüller — şema hazır
// ---------------------------------------------------------------------------

model DuesRecord {
  id            String             @id @default(cuid())
  period        DateTime
  amount        Decimal            @db.Decimal(12, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(12, 2)
  paymentDate   DateTime?
  paymentMethod DuesPaymentMethod?
  lateFee       Decimal            @default(0) @db.Decimal(12, 2)
  createdAt     DateTime           @default(now())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  payments DuesPayment[]

  @@unique([unitId, period])
  @@index([unitId])
}

/// Bir aidat kaydına yapılan her bir ödeme işlemi — makbuz üretimi ve kısmi ödeme geçmişi için.
model DuesPayment {
  id            String            @id @default(cuid())
  amount        Decimal           @db.Decimal(12, 2)
  paymentDate   DateTime
  paymentMethod DuesPaymentMethod
  createdAt     DateTime          @default(now())

  duesRecordId String
  duesRecord   DuesRecord @relation(fields: [duesRecordId], references: [id], onDelete: Cascade)

  @@index([duesRecordId])
}

model Expense {
  id            String   @id @default(cuid())
  category      String
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  description   String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

/// Yıllık bütçe planlaması — kategori bazlı planlanan tutar; gerçekleşen, Expense kayıtlarından hesaplanır.
model BudgetItem {
  id            String   @id @default(cuid())
  year          Int
  category      String
  plannedAmount Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, year, category])
  @@index([siteId])
}

/// Kasa/banka hesabı takibi — manuel bakiye girişi ve hareket geçmişi. Güncel bakiye
/// openingBalance + toplam GIRIS - toplam CIKIS olarak hesaplanır (ayrıca saklanmaz).
model BankAccount {
  id             String          @id @default(cuid())
  name           String
  type           BankAccountType @default(KASA)
  bankName       String?
  iban           String?
  openingBalance Decimal         @default(0) @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  transactions BankTransaction[]

  @@index([siteId])
}

model BankTransaction {
  id          String               @id @default(cuid())
  date        DateTime
  amount      Decimal              @db.Decimal(12, 2)
  direction   TransactionDirection
  description String?
  createdAt   DateTime             @default(now())

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model MaintenanceSchedule {
  id           String            @id @default(cuid())
  equipment    String
  period       MaintenancePeriod
  lastDoneDate DateTime?
  nextDueDate  DateTime?
  createdAt    DateTime          @default(now())

  siteId   String
  site     Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  logs MaintenanceLog[]

  @@index([siteId])
}

model MaintenanceLog {
  id            String   @id @default(cuid())
  performedDate DateTime
  performedBy   String?
  cost          Decimal? @db.Decimal(12, 2)
  notes         String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  scheduleId String
  schedule   MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model Ticket {
  id          String         @id @default(cuid())
  reportedBy  String
  category    String
  description String
  priority    TicketPriority @default(ORTA)
  status      TicketStatus   @default(ACIK)
  assignedTo  String?
  openedAt    DateTime       @default(now())
  closedAt    DateTime?

  siteId String
  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([unitId])
}

model Vendor {
  id              String    @id @default(cuid())
  name            String
  serviceType     String
  contactInfo     String?
  contractStart   DateTime?
  contractEnd     DateTime?
  contractFileUrl String?
  createdAt       DateTime  @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sites                Site[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([companyId])
}

model Staff {
  id         String    @id @default(cuid())
  fullName   String
  position   String
  hireDate   DateTime?
  salaryInfo Decimal?  @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Meeting {
  id             String   @id @default(cuid())
  date           DateTime
  agenda         String?
  participants   String?
  minutesText    String?
  minutesFileUrl String?
  createdAt      DateTime @default(now())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  decisions Decision[]

  @@index([siteId])
}

model Decision {
  id             String   @id @default(cuid())
  decisionNumber String
  date           DateTime
  text           String
  createdAt      DateTime @default(now())

  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([siteId])
}

model Document {
  id         String   @id @default(cuid())
  type       String
  fileUrl    String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  content     String
  audience    AnnouncementAudience @default(TUM_SITE)
  publishDate DateTime             @default(now())
  createdAt   DateTime             @default(now())

  siteId  String
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blockId String?
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  /// audience = SECILI_DAIRELER olduğunda hedeflenen daireler
  units Unit[]

  @@index([siteId])
}

model Invoice {
  id        String        @id @default(cuid())
  period    DateTime
  unitCount Int
  amount    Decimal       @db.Decimal(12, 2)
  status    InvoiceStatus @default(BEKLIYOR)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period])
  @@index([companyId])
}

/// Apsis abonelik paket kataloğu — superadmin tarafından yönetilir. Şirketler bir pakete
/// atanır (Company.packageId); isCustom=true olan paket (ör. "Özel"), Company.customUnitLimit
/// ve Company.customMonthlyPrice ile birlikte kullanılır (unitLimit/monthlyPrice burada null kalır).
model SubscriptionPackage {
  id           String   @id @default(cuid())
  name         String   @unique
  unitLimit    Int?
  monthlyPrice Decimal? @db.Decimal(12, 2)
  isCustom     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies            Company[] @relation("CompanyPackage")
  requestedByCompanies Company[] @relation("CompanyRequestedPackage")
}
